# Copy to .env and fill in values: cp .env.example .env

# Airflow metadata database - container airflow-postgres (user: airflow, db: airflow)
AIRFLOW_DB_PASSWORD=airflow

# Taxi data warehouse - container dw-postgres (avoid URL special characters like @ : / in the password)
DW_DB_USER=dw_user
DW_DB_PASSWORD=dw_password
DW_DB_NAME=taxi_dw
# Host port for the warehouse (5432 is already used by a local Postgres on this machine)
DW_HOST_PORT=5433

# Airflow
AIRFLOW_UID=50000
# Airflow UI port on the host (8080 is inside a Windows-reserved port range here)
AIRFLOW_HOST_PORT=8888
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
FERNET_KEY=<generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())">
AIRFLOW_JWT_SECRET=<generate: python -c "import secrets;print(secrets.token_urlsafe(32))">

# Superset (dashboards)
# Superset UI port on the host
SUPERSET_HOST_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Superset metadata database - container superset-postgres (user: superset, db: superset)
SUPERSET_DB_PASSWORD=superset
SUPERSET_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(42))">
